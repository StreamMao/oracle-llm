# ==============================================================================
# Oracle Cloud Always Free ARM (2 OCPU / 4GB RAM) LLM Configuration
# ==============================================================================

# Server Listening Port (Make sure to open this in OCI Security List & OS Firewall)
PORT=8080

# Model File Name in ./models directory
MODEL_FILENAME=qwen2.5-3b-instruct-q4_k_m.gguf

# Model Download URL (HuggingFace direct GGUF download link)
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/main/qwen2.5-3b-instruct-q4_k_m.gguf

# Context Size (Tokens). 2048 is recommended for 4GB RAM to save memory.
CTX_SIZE=2048

# Inference Threads (Match your OCPU count, default 2 for Always Free ARM)
THREADS=2

# Concurrent Requests
N_PARALLEL=1

# Optional API Key (Leave blank for no authentication)
API_KEY=

# Docker memory limit (leave some RAM for OS & system processes)
MAX_MEMORY=3500M

# Flash Attention (0 = disabled for CPU stability)
FLASH_ATTN=0
