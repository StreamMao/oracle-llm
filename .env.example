# ==============================================================================
# Oracle Cloud Always Free ARM (Ampere A1) LLM Configuration
# ==============================================================================

# Server Listening Port (Make sure to open this in OCI Security List & OS Firewall)
PORT=8080

# ------------------------------------------------------------------------------
# Model Selection Guide (Uncomment the one you want)
# ------------------------------------------------------------------------------

# --- 🌟 12GB RAM 旗舰推荐 (7B~8B 参数，智商与复杂推理天花板) ---

# [1] DeepSeek-R1-Distill-Qwen-7B (强烈推荐: <think>深度思考推演，逻辑/分析之王)
MODEL_FILENAME=DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf
MODEL_URL=https://huggingface.co/unsloth/DeepSeek-R1-Distill-Qwen-7B-GGUF/resolve/main/DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf
CTX_SIZE=4096
MAX_MEMORY=10000M

# [2] Qwen2.5-7B-Instruct (7B中文综合天花板，知识面极广，格式遵循极强)
# MODEL_FILENAME=qwen2.5-7b-instruct-q4_k_m.gguf
# MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-7B-Instruct-GGUF/resolve/main/qwen2.5-7b-instruct-q4_k_m.gguf
# CTX_SIZE=4096
# MAX_MEMORY=10000M

# [3] Qwen2.5-Coder-7B-Instruct (7B代码编写/重构/Debug神器)
# MODEL_FILENAME=qwen2.5-coder-7b-instruct-q4_k_m.gguf
# MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-7B-Instruct-GGUF/resolve/main/qwen2.5-coder-7b-instruct-q4_k_m.gguf
# CTX_SIZE=4096
# MAX_MEMORY=10000M

# [4] Meta-Llama-3.1-8B-Instruct (Meta 8B 经典旗舰，英文与通用逻辑)
# MODEL_FILENAME=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# MODEL_URL=https://huggingface.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF/resolve/main/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# CTX_SIZE=4096
# MAX_MEMORY=10000M


# --- ⚡ 4GB~12GB RAM 轻量均衡推荐 (1.5B~4B 参数，极速响应/高并发) ---

# [5] Qwen2.5-3B-Instruct (4GB机器默认推荐: 综合能力最均衡，流畅打字速度)
# MODEL_FILENAME=qwen2.5-3b-instruct-q4_k_m.gguf
